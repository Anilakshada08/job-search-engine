# Copy to .env (gitignored) and fill in.
# Anthropic credentials: either an API key or an `ant auth login` profile.
ANTHROPIC_API_KEY=

# Where tailored resumes and run artifacts are written. MUST be outside the repo.
JOBHUNT_OUTPUT_DIR=C:/Users/you/JobHunt/output

# Gmail API OAuth files (Desktop app client). Keep them outside the repo.
GMAIL_CREDENTIALS_FILE=C:/Users/you/JobHunt/secrets/credentials.json
GMAIL_TOKEN_FILE=C:/Users/you/JobHunt/secrets/token.json

# Optional phone notification (ntfy.sh topic). Leave blank to disable.
NTFY_TOPIC=
